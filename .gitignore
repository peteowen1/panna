# R project files
.Rproj.user
.Rhistory
.RData
.Ruserdata

# Package build artifacts
*.tar.gz
*.Rcheck/

# Cache directories (large data files) — glob covers ad-hoc suffixed caches
# like cache-predictions-opta-newgl/ from one-off backfills
data-raw/cache/
data-raw/cache-*/
data-raw/debug/
data-raw/archive/
data/

# Claude Code (local settings)
.claude/

# pkgdown output (rebuilt fresh by .github/workflows/pkgdown.yaml, deployed to gh-pages)
docs/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
.httr-oauth
.quarto

# Credentials/secrets
.env
*.pem
credentials.json

# Claude Code temp files
tmpclaude-*
debug/
_ul*
.obsidian/

# Transient local-run logs (underscore-prefixed Rscript run output)
_*.log

# One-off scratch pipeline runners (session drivers, regenerable)
data-raw/**/_run_*.R
data-raw/explainer/*.html
